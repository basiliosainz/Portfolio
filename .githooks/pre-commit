#!/bin/sh
# Keeps assets/media/*/manifest.json in sync automatically before every
# commit, so renaming/adding/removing files in a media folder never needs
# a manual `npm run build:media` - it just happens when you commit.
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

node scripts/build-media.mjs

git add assets/media/*/manifest.json
